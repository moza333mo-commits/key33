<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/keys_arabic3_left" />
    <switch>
        <!-- Gboard-style Long-Press Symbols on Arabic Row 3 (When pref_show_special_chars is enabled) -->
        <case latin:showExtraChars="true">
            <!-- ء -> * -->
            <Key
                latin:keySpec="&#x0621;"
                latin:keyHintLabel="*"
                latin:additionalMoreKeys="*" />
            <!-- ؤ -> ' -->
            <Key
                latin:keySpec="&#x0624;"
                latin:keyHintLabel="&apos;"
                latin:additionalMoreKeys="&apos;" />
            <!-- ر -> : -->
            <Key
                latin:keySpec="&#x0631;"
                latin:keyHintLabel=":"
                latin:additionalMoreKeys=":" />
            <!-- ى -> ! -->
            <Key
                latin:keySpec="&#x0649;"
                latin:keyHintLabel="!"
                latin:additionalMoreKeys="!"
                latin:moreKeys="&#x0626;" />
            <!-- ة -> ؟ -->
            <Key
                latin:keySpec="&#x0629;"
                latin:keyHintLabel="&#x061F;"
                latin:additionalMoreKeys="&#x061F;,\\?" />
            <!-- و -> ، -->
            <Key
                latin:keySpec="&#x0648;"
                latin:keyHintLabel="&#x060C;"
                latin:additionalMoreKeys="&#x060C;,\\," />
            <!-- ز -> / -->
            <Key
                latin:keySpec="&#x0632;"
                latin:keyHintLabel="/"
                latin:additionalMoreKeys="/"
                latin:moreKeys="&#x0698;" />
            <!-- ظ -> $ -->
            <Key
                latin:keySpec="&#x0638;"
                latin:keyHintLabel="$"
                latin:additionalMoreKeys="$" />
            <!-- د -> = -->
            <Key
                latin:keySpec="&#x062F;"
                latin:keyHintLabel="="
                latin:additionalMoreKeys="=" />
        </case>
        <default>
            <Key latin:keySpec="&#x0621;" />
            <Key latin:keySpec="&#x0624;" />
            <Key latin:keySpec="&#x0631;" />
            <Key
                latin:keySpec="&#x0649;"
                latin:moreKeys="&#x0626;" />
            <Key latin:keySpec="&#x0629;" latin:moreKeys="&#x061F;,\?" />
            <Key latin:keySpec="&#x0648;" latin:moreKeys="&#x060C;,\," />
            <Key
                latin:keySpec="&#x0632;"
                latin:moreKeys="&#x0698;" />
            <Key latin:keySpec="&#x0638;" />
            <Key latin:keySpec="&#x062F;" />
        </default>
    </switch>
</merge>
